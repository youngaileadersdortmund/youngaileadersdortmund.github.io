# Google Drive integration for the events carousel.
# Copy this file to .env and fill in real values. .env is gitignored.

# Drive folder ID — the part of the folder URL after /folders/
# The folder MUST be shared as "Anyone with the link can view" so the API key
# alone can read it (no OAuth).
VITE_GOOGLE_DRIVE_FOLDER_ID=

# Google Cloud API key with Drive API enabled.
# Restrict it in GCP Console:
#   - Application restrictions: HTTP referrers
#     Add: https://youngaileaders-dortmund.de/*  and  http://localhost:5173/*
#   - API restrictions: Google Drive API only
VITE_GOOGLE_DRIVE_API_KEY=

# Endpoint that receives the "Join the Hub" form submission and forwards it
# to dortmundhub.youngaileaders@gmail.com via Resend.
# This is the URL of your deployed Cloudflare Worker (see worker/ folder).
# Example: https://yal-apply.youraccount.workers.dev
VITE_FORM_ENDPOINT=

# Optional convention for per-file metadata.
# In each Drive image's "Description" field you can put JSON like:
# {
#   "title":       { "de": "Community-Treffen", "en": "Community Meetup" },
#   "description": { "de": "Kurzbeschreibung…",  "en": "Short blurb…" }
# }
# If the description isn't valid JSON, the raw text is used for both languages
# and the file name becomes the title.
