# Email address that receives Join the Hub applications.
RESEND_EMAIL=

# Secret Resend API key. Never expose this as a VITE_ variable.
RESEND_API_KEY=

# Required sender address.
# Use onboarding@resend.dev for local testing before you verify a domain.
# After domain verification in Resend, replace it with something like:
# FROM_EMAIL="Young AI Leaders Dortmund <join@youngaileaders.com>"
FROM_EMAIL=onboarding@resend.dev
